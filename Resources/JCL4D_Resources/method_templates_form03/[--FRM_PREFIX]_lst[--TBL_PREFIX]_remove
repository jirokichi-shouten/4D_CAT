//[--FRM_PREFIX]_lst[--TBL_PREFIX]_remove
//FG form03 v202608 [--DATE] Cursor
// リストボックスの選択行を削除

C_LONGINT($1;$index)
$index:=$1

If ($index>0)
	// リストボックス自身の選択配列から削除
	DELETE FROM ARRAY(v[--FRM_PREFIX]_lst[--TBL_PREFIX];$index;1)

	// 各列配列から削除
	DELETE FROM ARRAY(v[--FRM_PREFIX]_lst[--FIELD];$index;1)

End if 
