// リストボックスの選択行を削除

C_LONGINT($sizeOfAry; $j)

$sizeOfAry:=Size of array(v[--FRM_PREFIX]_lst[--TBL_PREFIX])
For ($j; $sizeOfAry; 1; -1)
	If (v[--FRM_PREFIX]_lst[--TBL_PREFIX]{$j}=True)
		[--FRM_PREFIX]_lst[--TBL_PREFIX]_remove($j)
	End if 
End for 

//選択状態をなしにする
JCL_lst_Deselect(->v[--FRM_PREFIX]_lst[--TBL_PREFIX])
